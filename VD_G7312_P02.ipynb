     "text": [
      "Personajes antes de limpiar: 389\n",
      "Personajes después de limpiar: 225\n",
      "\n",
      "Ejemplo de estructura limpia:\n",
      "- characterName: Aeron Greyjoy\n",
      "- houseName: Greyjoy\n",
      "- nickname: Damphair\n",
      "- siblings: ['Balon Greyjoy', 'Euron Greyjoy']\n"
