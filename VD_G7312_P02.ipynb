   "source": [
    "# Definimos primero la función auxiliar para fusionar duplicados\n",
    "from collections import defaultdict\n",
    "\n",
    "def fusionar_duplicados(personajes):\n",
    "    \"\"\"\n",
    "    Fusiona personajes con el mismo nombre en un solo grupo (nodo agrupado).\n",
    "    Combina todas sus relaciones sin repetirlas.\n",
    "    \"\"\"\n",
    "    grupos = defaultdict(list)\n",
    "    for p in personajes:\n",
    "        nombre = p.get(\"characterName\")\n",
    "        if not nombre:\n",
    "            continue\n",
    "        grupos[nombre].append(p)\n",
    "\n",
    "    personajes_fusionados = []\n",
    "    for nombre, apariciones in grupos.items():\n",
    "        if len(apariciones) > 1:\n",
    "            nuevo = {\"characterName\": f\"Grupo: {nombre}\"}\n",
    "            # fusionar relaciones relevantes\n",
    "            for campo in relaciones_personajes:\n",
    "                combinadas = set()\n",
    "                for p in apariciones:\n",
    "                    combinadas.update(p.get(campo, []))\n",
    "                if combinadas:\n",
    "                    nuevo[campo] = list(combinadas)\n",
    "            personajes_fusionados.append(nuevo)\n",
    "        else:\n",
    "            personajes_fusionados.append(apariciones[0])\n",
    "    return personajes_fusionados\n",
    "\n",
    "\n",
    "# Función principal de limpieza avanzada\n",
    "def limpiar_personajes_avanzado(personajes, nombres_duplicados, campos_utiles):\n",
    "    \"\"\"\n",
    "    Limpieza avanzada:\n",
    "    - Elimina personajes sin nombre o de lista genérica.\n",
    "    - Fusiona duplicados en grupos.\n",
    "    - Elimina suicidios puros (solo se matan a sí mismos sin más relaciones).\n",
    "    - Mantiene solo los campos útiles.\n",
    "    \"\"\"\n",
    "    # Primero filtramos los personajes por nombre\n",
    "    filtrados = [\n",
    "        p for p in personajes\n",
    "        if p.get(\"characterName\") and p[\"characterName\"] not in nombres_duplicados\n",
    "    ]\n",
    "\n",
    "    # Fusionar duplicados en grupos\n",
    "    fusionados = fusionar_duplicados(filtrados)\n",
    "    personajes_limpios = []\n",
    "\n",
    "    for p in fusionados:\n",
    "        name = p.get(\"characterName\")\n",
    "        if not name:\n",
    "            continue\n",
    "\n",
    "        # Extraer solo campos relevantes (atributos + relaciones)\n",
    "        limpio = {k: p[k] for k in campos_utiles if k in p}\n",
    "\n",
    "        # Buscar relaciones activas (listas no vacías)\n",
    "        relaciones = {k: v for k, v in limpio.items() if isinstance(v, list) and len(v) > 0}\n",
    "        if not relaciones:\n",
    "            continue\n",
    "\n",
    "        # Comprobar suicidio\n",
    "        suicida = False\n",
    "        for rel in [\"killed\", \"killedBy\"]:\n",
    "            if rel in relaciones and set(relaciones[rel]) == {name}:\n",
    "                suicida = True\n",
    "                break\n",
    "\n",
    "        # Si solo se suicida y no tiene más relaciones -> excluir\n",
    "        if suicida and set(relaciones.keys()).issubset({\"killed\", \"killedBy\"}):\n",
    "            continue\n",
    "\n",
    "        personajes_limpios.append(limpio)\n",
    "\n",
    "    return personajes_limpios\n",
    "\n",
    "# Campos útiles: identificativos + relaciones válidas\n",
    "campos_basicos = [\"characterName\", \"houseName\", \"royal\", \"kingsguard\", \"nickname\"]\n",
    "campos_utiles = campos_basicos + list(relaciones_validas)\n",
    "\n",
    "# Aplicamos la limpieza sobre tu dataset original\n",
    "data_chars_limpio = limpiar_personajes_avanzado(\n",
    "    data_chars,\n",
    "    duplicados,\n",
    "    campos_utiles\n",
    ")\n",
    "\n",
    "# Comprobaciones\n",
    "print(f\"Personajes antes de limpiar: {len(data_chars)}\")\n",
    "print(f\"Personajes después de limpiar: {len(data_chars_limpio)}\")\n",
    "\n",
    "# Mostrar ejemplo del resultado\n",
    "print(\"\\nEjemplo de estructura limpia:\")\n",
    "for k, v in data_chars_limpio[1].items():\n",
    "    print(f\"- {k}: {v}\")\n"
   ]
